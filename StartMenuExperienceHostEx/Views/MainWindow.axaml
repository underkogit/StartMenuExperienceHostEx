<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StartMenuExperienceHostEx.ViewModels"
    xmlns:controls="clr-namespace:StartMenuExperienceHostEx.Views.Controls"
    x:Class="StartMenuExperienceHostEx.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    x:CompileBindings="False"

     
 
  
    WindowDecorations="BorderOnly"
    CanResize="True"
     

    
    WindowStartupLocation="CenterScreen"
    Background="#242424"

    Width="800"
    Height="400"

    DragDrop.AllowDrop="True"
    DragDrop.DragOver="Window_OnDragOver"
    DragDrop.Drop="Window_OnDrop"

    Loaded="OnLoaded"
    Closing="WinOnClosing"
    Closed="WinOnClosed">
    
    <Grid>
        
        
        <controls:DraggableCanvas Name="PCanvas" Background="Transparent">
             
        </controls:DraggableCanvas>
        
        
    </Grid>
</Window>