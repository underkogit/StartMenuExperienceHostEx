<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             x:CompileBindings="False"

             mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="80"
             x:Class="StartMenuExperienceHostEx.Views.Controls.ApplicationControl">
    <Border CornerRadius="4" Padding="20,0" Background="#43454a">
        <StackPanel Orientation="Vertical" Background="red" Margin="0,10, 0,5">
            <Image
                Width="45"
                Height="45"
                Source="{Binding Image, ElementName=Root}"
                Stretch="UniformToFill" />

            <TextBlock
                HorizontalAlignment="Center"
                Text="{Binding ApplicationName, ElementName=Root}"
                FontSize="12"
                Foreground="White" />
        </StackPanel>
    </Border>


</UserControl>